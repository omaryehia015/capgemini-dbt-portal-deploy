# Copy to .env and fill in. Every line below is optional -- delete anything
# you don't need. There is no required config file at all if you're happy
# with a git-cloned project (section 2) and the defaults.

# ── Where's my project? ──────────────────────────────────────────────────
# Path to your dbt project folder (the one with dbt_project.yml in it).
# Relative to this compose.yaml. Warehouse credentials come from THAT
# project's own .env -- nothing to duplicate here.
DBT_PROJECT_PATH=../my-dbt-project

# ── OR: no folder to mount? Let the container clone it ─────────────────
# DBT_PROJECT_GIT_URL=https://github.com/ORG/REPO.git
# DBT_PROJECT_GIT_REF=main
# DBT_PROJECT_GIT_TOKEN=            # private repo: a read-only token
# DBT_PROJECT_SUBDIR=                # dbt project is a sub-folder of the repo

# ── Which images ──────────────────────────────────────────────────────────
# IMAGE_REGISTRY=ghcr.io/OWNER/REPO
# IMAGE_TAG=1.0.0

# ── Sign-in (optional) ──────────────────────────────────────────────────────
# Portal username/email + password always works. Add your company directory
# and/or passwordless email codes (these can also go in the project's .env).
# LDAP_URL=ldaps://dc.corp.local:636
# LDAP_USER_DN={username}@corp.local     # OpenLDAP: uid={username},ou=people,dc=corp,dc=com
# LDAP_BASE_DN=dc=corp,dc=local          # optional: fills in name + email on first sign-in
# LDAP_DEFAULT_ROLE=Data Analyst         # role given to a directory user's first sign-in
# SMTP_HOST=smtp.office365.com           # set to turn on "email me a sign-in code"
# SMTP_PORT=587
# SMTP_USERNAME=portal@company.com
# SMTP_PASSWORD=
# SMTP_FROM=portal@company.com

# ── Rarely needed ─────────────────────────────────────────────────────────
# PORTAL_PORT=8080
# PORTAL_USER=0:0                    # Windows/macOS bind mounts only (dbt deps needs it); onboard scripts set this
# JWT_SECRET=                        # default: auto-generated, persists in the data volume
# DATABASE_URL=                      # default: SQLite in the data volume

# Copy to secrets.env (git-ignored) -> Secret dbt-portal-secrets.
# Prefer the client's secret manager (External Secrets, Sealed Secrets, Vault)
# in real installs; this file is the simplest working option.
# Generate each secret with: openssl rand -base64 36

# Signs the session tokens.
JWT_SECRET=
# Shared by the backend and Cube.
CUBE_API_SECRET=

# PostgreSQL: one database. With the bundled data-stores.yaml,
# POSTGRES_PASSWORD is the password it is created with.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg2://portal:PASSWORD@dbt-portal-postgres:5432/portal

# Redis: job queue, live logs, cache invalidation, email sign-in codes.
REDIS_PASSWORD=
REDIS_URL=redis://:PASSWORD@dbt-portal-redis:6379/0

# Read-only deploy token for DBT_PROJECT_GIT_URL (omit for public repos).
DBT_PROJECT_GIT_TOKEN=
# DBT_PROJECT_GIT_USERNAME=oauth2   # GitLab; GitHub works with the default

# Whatever the client's profiles.yml reads through env_var(...). Simplest: leave
# these empty and connect the warehouse in the portal (Setup Assistant).
# Snowflake:
DBT_PKG_ACCOUNT=
DBT_PKG_USER=
DBT_PKG_PASSWORD=
DBT_PKG_ROLE=
DBT_PKG_WAREHOUSE=
DBT_PKG_DATABASE=
# Databricks (DBT_PKG_DATABASE above names the metadata catalog):
# DBT_WH_TYPE=databricks
# DATABRICKS_HOST=adb-1234567890123456.7.azuredatabricks.net
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abc123
# DATABRICKS_TOKEN=

# Optional: initial passwords for the seeded portal accounts. Unset in
# production, random ones are generated and printed once in the backend log.
# SEED_ADMIN_PASSWORD=

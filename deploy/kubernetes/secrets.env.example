# Copy to secrets.env (git-ignored) -> Secret dbt-portal-secrets.
# Prefer the client's secret manager (External Secrets, Sealed Secrets, Vault)
# in real installs; this file is the simplest working option.

# Leave blank: generated on first start and persisted on the dbt-portal-data
# PVC (survives pod restarts). Set it only to pin/rotate it explicitly.
# JWT_SECRET=

# Read-only deploy token for DBT_PROJECT_GIT_URL (omit for public repos).
DBT_PROJECT_GIT_TOKEN=
# DBT_PROJECT_GIT_USERNAME=oauth2   # GitLab; GitHub works with the default

# Whatever the client's profiles.yml reads through env_var(...).
DBT_PKG_ACCOUNT=
DBT_PKG_USER=
DBT_PKG_PASSWORD=
DBT_PKG_ROLE=
DBT_PKG_WAREHOUSE=
DBT_PKG_DATABASE=

# Optional: initial passwords for the seeded portal accounts. Unset in
# production, random ones are generated and printed once in the backend log.
# SEED_ADMIN_PASSWORD=

# Optional: external portal database instead of SQLite on the PVC.
# DATABASE_URL=postgresql+psycopg2://portal:PASSWORD@postgres:5432/dbt_portal

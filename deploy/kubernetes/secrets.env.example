# Copy to secrets.env (git-ignored) -> Secret dbt-portal-secrets.
# Prefer the client's secret manager (External Secrets, Sealed Secrets, Vault)
# in real installs; this file is the simplest working option.
# Generate each secret with: openssl rand -base64 36

# Every service verifies the same session tokens.
JWT_SECRET=
# Shared by the semantic service and Cube.
CUBE_API_SECRET=

# PostgreSQL: one database per service that owns tables. With the bundled
# data-stores.yaml, POSTGRES_PASSWORD is the password it is created with.
POSTGRES_PASSWORD=
DATABASE_URL_IDENTITY=postgresql+psycopg2://portal:PASSWORD@dbt-portal-postgres:5432/portal_identity
DATABASE_URL_EXECUTION=postgresql+psycopg2://portal:PASSWORD@dbt-portal-postgres:5432/portal_execution

# Redis: job queue, live logs, cache invalidation, email sign-in codes.
REDIS_PASSWORD=
REDIS_URL=redis://:PASSWORD@dbt-portal-redis:6379/0

# Read-only deploy token for DBT_PROJECT_GIT_URL (omit for public repos).
DBT_PROJECT_GIT_TOKEN=
# DBT_PROJECT_GIT_USERNAME=oauth2   # GitLab; GitHub works with the default

# Whatever the client's profiles.yml reads through env_var(...).
DBT_PKG_ACCOUNT=
DBT_PKG_USER=
DBT_PKG_PASSWORD=
DBT_PKG_ROLE=
DBT_PKG_WAREHOUSE=
DBT_PKG_DATABASE=

# Optional: initial passwords for the seeded portal accounts. Unset in
# production, random ones are generated and printed once in the identity log.
# SEED_ADMIN_PASSWORD=

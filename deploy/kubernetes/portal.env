# Non-secret backend settings -> ConfigMap dbt-portal-config.
# Secrets (passwords, tokens) go in secrets.env instead.
ENVIRONMENT=production

# Project source: git mode (the backend clones into an emptyDir on start).
# To use a shared volume instead, remove these and see the PVC notes in
# backend.yaml.
DBT_PROJECT_GIT_URL=https://github.com/ORG/REPO.git
DBT_PROJECT_GIT_REF=main
# DBT_PROJECT_SUBDIR=transform/dbt

DBT_TARGET=prod
DBT_DEPS_ON_START=true
# DBT_PROFILES_DIR=/etc/dbt   # when profiles.yml comes from the dbt-profiles Secret

# AIRFLOW_URL=http://airflow-webserver.airflow.svc.cluster.local:8080
# DATABASE_URL -> set in secrets.env if it carries a password

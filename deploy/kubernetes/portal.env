# Non-secret settings shared by the backend services -> ConfigMap dbt-portal-config.
# Secrets (passwords, tokens, database URLs) go in secrets.env instead.
ENVIRONMENT=production
DBT_PROJECT_DIR=/workspace

# How the services reach each other (Service names in this namespace).
IDENTITY_URL=http://dbt-portal-identity:8000
EXECUTION_URL=http://dbt-portal-execution:8000
INSIGHTS_URL=http://dbt-portal-insights:8000
SEMANTIC_URL=http://dbt-portal-semantic:8000
CUBE_API_URL=http://dbt-portal-cube:4000

# Project source: git mode. Only the execution API clones (into the shared
# workspace volume); see workspace.yaml.
DBT_PROJECT_GIT_URL=https://github.com/ORG/REPO.git
DBT_PROJECT_GIT_REF=main
# DBT_PROJECT_SUBDIR=transform/dbt

DBT_TARGET=prod
DBT_DEPS_ON_START=true
# DBT_PROFILES_DIR=/etc/dbt   # when profiles.yml comes from a Secret

# AIRFLOW_URL=http://airflow-webserver.airflow.svc.cluster.local:8080

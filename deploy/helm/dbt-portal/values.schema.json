{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dbt-portal chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {"type": "string"},
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["", "Always", "IfNotPresent", "Never"]}
      }
    },
    "dataImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["", "Always", "IfNotPresent", "Never"]}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "initialDelaySeconds": {"type": "integer", "minimum": 0},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "successThreshold": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "accessModes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]}
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {"$ref": "#/definitions/accessModes"},
        "size": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k)?$"},        "annotations": {"type": "object"}
      }
    },
    "scalarMap": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "scheduling": {
      "nodeSelector": {"type": "object"},
      "tolerations": {"type": "array"},
      "affinity": {"type": "object"},
      "priorityClassName": {"type": "string"}
    }
  },
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "imageRegistry": {"type": "string"},
    "imagePullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
    "imagePullSecrets": {
      "type": "array",
      "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}
    },
    "allowLatestTag": {"type": "boolean"},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"},
        "automountServiceAccountToken": {"type": "boolean"}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "enum": ["git", "volume"]},
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {"type": "string"},
            "ref": {"type": "string"},
            "username": {"type": "string"}
          }
        },
        "subdir": {"type": "string"},
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {"type": "string"},
            "key": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {"type": "string", "enum": ["production", "development"]},
        "logFormat": {"type": "string", "enum": ["json", "text"]},
        "dbtTarget": {"type": "string"},
        "dbtDepsOnStart": {"type": "boolean"},
        "extra": {"$ref": "#/definitions/scalarMap"}
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "existingSecret": {"type": "string"},
        "values": {"$ref": "#/definitions/scalarMap"}
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"retainOnUninstall": {"type": "boolean"}}
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"persistence": {"$ref": "#/definitions/claim"}}
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"persistence": {"$ref": "#/definitions/claim"}}
    },
    "backups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"persistence": {"$ref": "#/definitions/claim"}}
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 0},
        "image": {"$ref": "#/definitions/image"},
        "strategy": {"type": "object"},
        "forwardedHops": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "metrics": {"type": "object", "additionalProperties": false, "properties": {"annotations": {"type": "boolean"}}},
        "extraEnv": {"type": "array"},
        "podAnnotations": {"type": "object"},
        "podLabels": {"type": "object"},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startup": {"$ref": "#/definitions/probe"},
            "readiness": {"$ref": "#/definitions/probe"},
            "liveness": {"$ref": "#/definitions/probe"}
          }
        },
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "priorityClassName": {"type": "string"}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 0},
        "concurrency": {"type": "integer", "minimum": 1},
        "mountData": {"type": "boolean"},
        "extraEnv": {"type": "array"},
        "podAnnotations": {"type": "object"},
        "podLabels": {"type": "object"},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startup": {"$ref": "#/definitions/probe"},
            "liveness": {"$ref": "#/definitions/probe"}
          }
        },
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "priorityClassName": {"type": "string"}
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 0},
        "image": {"$ref": "#/definitions/image"},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "annotations": {"type": "object"}
          }
        },
        "airflowUpstream": {"type": "string", "pattern": "^$|^[A-Za-z0-9._-]+(:[0-9]+)?$"},
        "extraEnv": {"type": "array"},
        "podAnnotations": {"type": "object"},
        "podLabels": {"type": "object"},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startup": {"$ref": "#/definitions/probe"},
            "readiness": {"$ref": "#/definitions/probe"},
            "liveness": {"$ref": "#/definitions/probe"}
          }
        },
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "priorityClassName": {"type": "string"}
      }
    },
    "cube": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 0},
        "image": {"$ref": "#/definitions/image"},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "sql": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            }
          }
        },
        "extraEnv": {"type": "array"},
        "podAnnotations": {"type": "object"},
        "podLabels": {"type": "object"},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startup": {"$ref": "#/definitions/probe"},
            "readiness": {"$ref": "#/definitions/probe"},
            "liveness": {"$ref": "#/definitions/probe"}
          }
        },
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "priorityClassName": {"type": "string"}
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/dataImage"},
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
            "database": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"}
          }
        },
        "persistence": {"$ref": "#/definitions/claim"},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"}
      }
    },
    "legacyMigration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/dataImage"},
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {"type": "string"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "user": {"type": "string", "pattern": "^$|^[a-z_][a-z0-9_]*$"}
          }
        },
        "passwordSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string"},
            "key": {"type": "string", "minLength": 1}
          }
        },
        "backoffLimit": {"type": "integer", "minimum": 0},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"}
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/dataImage"},
        "persistence": {"$ref": "#/definitions/claim"},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host"],
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {"type": "string", "pattern": "^/"},
                    "pathType": {"type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"]}
                  }
                }
              }
            }
          }
        },
        "tls": {"type": "array"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "frontendFrom": {"type": "array"},
        "backendFrom": {"type": "array"},
        "cubeSqlFrom": {"type": "array"}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": ["integer", "string"]}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"secrets": {"properties": {"create": {"const": false}}, "required": ["create"]}},
        "required": ["secrets"]
      },
      "then": {
        "properties": {"secrets": {"required": ["existingSecret"], "properties": {"existingSecret": {"type": "string", "minLength": 1}}}}
      }
    }
  ]
}

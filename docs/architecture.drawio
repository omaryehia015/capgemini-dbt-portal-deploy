rent="c545"><mxGeometry x="14" y="220" width="532" height="50" as="geometry"/></mxCell><mxCell id="c563" value="4" style="ellipse;html=1;fillColor=#E11D48;strokeColor=none;fontColor=#fff;fontStyle=1;fontSize=15;" vertex="1" parent="c545"><mxGeometry x="20" y="226" width="38" height="38" as="geometry"/></mxCell><mxCell id="c564" value="&lt;b&gt;Build observability&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=14.4;fontColor=#0B2C4D;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c545"><mxGeometry x="66" y="222" width="470" height="24" as="geometry"/></mxCell><mxCell id="c565" value="dbt run -s elementary (+FinOps), dbt test" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#475569;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c545"><mxGeometry x="66" y="244" width="470" height="24" as="geometry"/></mxCell><mxCell id="c566" value="" style="rounded=1;arcSize=14;html=1;fillColor=#FFFFFF;strokeColor=#E11D48;strokeWidth=1.5;" vertex="1" parent="c545"><mxGeometry x="14" y="276" width="532" height="50" as="geometry"/></mxCell><mxCell id="c567" value="5" style="ellipse;html=1;fillColor=#E11D48;strokeColor=none;fontColor=#fff;fontStyle=1;fontSize=15;" vertex="1" parent="c545"><mxGeometry x="20" y="282" width="38" height="38" as="geometry"/></mxCell><mxCell id="c568" value="&lt;b&gt;Generate reports&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=14.4;fontColor=#0B2C4D;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c545"><mxGeometry x="66" y="278" width="470" height="24" as="geometry"/></mxCell><mxCell id="c569" value="dbt docs · Colibri · edr report" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#475569;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c545"><mxGeometry x="66" y="300" width="470" height="24" as="geometry"/></mxCell><mxCell id="c570" value="&lt;b&gt;Path A&lt;/b&gt; — &lt;i&gt;packages.yml → dbt deps → portal.py onboard&lt;/i&gt; (dbt on your machine)&lt;br&gt;&lt;b&gt;Path B&lt;/b&gt; — download portal.py → &lt;i&gt;onboard&lt;/i&gt; (dbt deps runs in the container)&lt;br&gt;• auto-detects Docker / Podman, writes the project&#x27;s &lt;b&gt;.env&lt;/b&gt;, asks only what&#x27;s missing&lt;br&gt;• &lt;b&gt;daily refresh at 02:30&lt;/b&gt; (--schedule hourly | off) · status · stop · upgrade&lt;br&gt;• --release pins a tested combination · --core-ref · --port · --ca-cert (TLS proxy) · --no-pull (docker load) · --yes (CI)&lt;br&gt;• admin login for one-off DB creation is &lt;b&gt;never stored&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#374151;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c545"><mxGeometry x="14" y="336" width="532" height="170" as="geometry"/></mxCell><mxCell id="c571" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#0070AD;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1512" y="1940" width="640" height="560" as="geometry"/></mxCell><mxCell id="c572" value="" style="rounded=1;arcSize=0;html=1;fillColor=#0070AD;strokeColor=#0070AD;" vertex="1" parent="c571"><mxGeometry x="0" y="0" width="640" height="40" as="geometry"/></mxCell><mxCell id="c573" value="" style="rounded=1;arcSize=18;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="c571"><mxGeometry x="6" y="5" width="30" height="30" as="geometry"/></mxCell><mxCell id="c574" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c571"><mxGeometry x="8" y="7" width="26" height="26" as="geometry"/></mxCell><mxCell id="c575" value="&lt;b&gt;
8" y="7" width="26" height="26" as="geometry"/></mxCell><mxCell id="c478" value="&lt;b&gt;Snowflake&lt;/b&gt; &lt;font style=&quot;font-size:11px;opacity:.85&quot;&gt;&amp;nbsp;·&amp;nbsp; customer&#x27;s data cloud&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=16;fontColor=#ffffff;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c474"><mxGeometry x="44" y="4" width="626" height="32" as="geometry"/></mxCell><mxCell id="c479" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#29B5E8;strokeWidth=1.5;shadow=0;" vertex="1" parent="c474"><mxGeometry x="14" y="52" width="318" height="296" as="geometry"/></mxCell><mxCell id="c480" value="" style="rounded=0;html=1;fillColor=#29B5E8;strokeColor=none;" vertex="1" parent="c479"><mxGeometry x="0" y="6" width="4" height="284" as="geometry"/></mxCell><mxCell id="c481" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c479"><mxGeometry x="10" y="7" width="30" height="30" as="geometry"/></mxCell><mxCell id="c482" value="&lt;b&gt;Customer database&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=14;fontColor=#0B2C4D;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c479"><mxGeometry x="46" y="6" width="266" height="32" as="geometry"/></mxCell><mxCell id="c483" value="&lt;b&gt;your models — never touched&lt;/b&gt;&lt;br&gt;• dbt run / test / seed / snapshot&lt;br&gt;• Ask AI SELECT-only queries&lt;br&gt;• role &amp;amp; warehouse from profiles.yml&lt;br&gt;• env_var() credentials from .env&lt;br&gt;• SNOWFLAKE.ACCOUNT_USAGE (cost)&lt;br&gt;&amp;nbsp;&amp;nbsp;via GRANT IMPORTED PRIVILEGES&lt;br&gt;&lt;br&gt;&lt;b&gt;Connections&lt;/b&gt;&lt;br&gt;• worker: dbt run/test/build&lt;br&gt;• cube: semantic queries&lt;br&gt;• insights: results &amp;amp; cost reads&lt;br&gt;• execution: onboarding checks (dbt debug)" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#374151;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c479"><mxGeometry x="8" y="40" width="304" height="252" as="geometry"/></mxCell><mxCell id="c484" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#29B5E8;strokeWidth=1.5;shadow=0;" vertex="1" parent="c474"><mxGeometry x="346" y="52" width="320" height="296" as="geometry"/></mxCell><mxCell id="c485" value="" style="rounded=0;html=1;fillColor=#29B5E8;strokeColor=none;" vertex="1" parent="c484"><mxGeometry x="0" y="6" width="4" height="284" as="geometry"/></mxCell><mxCell id="c486" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c484"><mxGeometry x="10" y="7" width="30" height="30" as="geometry"/></mxCell><mxCell id="c487" value="&lt;b&gt;METADATA_ANALYTICS&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=14;fontColor=#0B2C4D;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c484"><mxGeometry x="46" y="6" width="268" height="32" as="geometry"/></mxCell><mxCell id="c488" value="&lt;b&gt;framework results, one schema per tool&lt;/b&gt;&lt;br&gt;• ELEMENTARY — test results, anomalies&lt;br&gt;• PROJECT_EVALUATOR — DAG &amp;amp; doc findings&lt;br&gt;• dbt_snowflake_monitoring — cost&lt;br&gt;• profiler · lint history&lt;br&gt;bootstrapped once by&lt;br&gt;&lt;i&gt;dbt run-operation bootstrap_metadata_database&lt;/i&gt;&lt;br&gt;(SYSADMIN-level step, never stored)&lt;br&gt;&lt;br&gt;&lt;b&gt;Why a separate database?&lt;/b&gt;&lt;br&gt;your own database stays untouched;&lt;br&gt;the framework writes only here" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#374151;align=left;verticalA
etry"/></mxCell><mxCell id="c232" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B6E4F;strokeWidth=1.5;shadow=0;" vertex="1" parent="c226"><mxGeometry x="14" y="48" width="292" height="306" as="geometry"/></mxCell><mxCell id="c233" value="" style="rounded=0;html=1;fillColor=#0B6E4F;strokeColor=none;" vertex="1" parent="c232"><mxGeometry x="0" y="6" width="4" height="294" as="geometry"/></mxCell><mxCell id="c234" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c232"><mxGeometry x="10" y="7" width="30" height="30" as="geometry"/></mxCell><mxCell id="c235" value="&lt;b&gt;identity&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=15;fontColor=#0B2C4D;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c232"><mxGeometry x="46" y="6" width="240" height="32" as="geometry"/></mxCell><mxCell id="c236" value="&lt;i&gt;image …-identity&lt;/i&gt;&lt;br&gt;&lt;b&gt;/api/auth · /api/governance&lt;/b&gt;&lt;br&gt;• sign-in, logout, refresh, lockouts&lt;br&gt;• users, roles, permission matrix&lt;br&gt;• governance policies&lt;br&gt;• audit trail (retried if unreachable)&lt;br&gt;• LDAP + email codes&lt;br&gt;• /internal/identity: user lookup, audit&lt;br&gt;&lt;b&gt;owns&lt;/b&gt; PostgreSQL &lt;i&gt;portal_identity&lt;/i&gt;&lt;br&gt;&lt;i&gt;stateless · any replicas&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=13.2;fontColor=#374151;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c232"><mxGeometry x="8" y="40" width="278" height="262" as="geometry"/></mxCell><mxCell id="c237" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0070AD;strokeWidth=1.5;shadow=0;" vertex="1" parent="c226"><mxGeometry x="314" y="48" width="360" height="306" as="geometry"/></mxCell><mxCell id="c238" value="" style="rounded=0;html=1;fillColor=#0070AD;strokeColor=none;" vertex="1" parent="c237"><mxGeometry x="0" y="6" width="4" height="294" as="geometry"/></mxCell><mxCell id="c239" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c237"><mxGeometry x="10" y="7" width="30" height="30" as="geometry"/></mxCell><mxCell id="c240" value="&lt;b&gt;execution API&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=15;fontColor=#0B2C4D;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c237"><mxGeometry x="46" y="6" width="308" height="32" as="geometry"/></mxCell><mxCell id="c241" value="&lt;i&gt;image …-backend · EXECUTION_ROLE=api&lt;/i&gt;&lt;br&gt;&lt;b&gt;/api/jobs (+log WebSocket) · dbt · dev · schedules&lt;/b&gt;&lt;br&gt;&lt;b&gt;onboarding · reports · airflow · airbyte · notifications · tools&lt;/b&gt;&lt;br&gt;• queue dbt runs, never runs dbt itself (waits ≤ 20 s for first status)&lt;br&gt;• dbt editor: read/write project, trash, git clone&lt;br&gt;• schedules &amp;amp; cron · failure alerts · Modules page&lt;br&gt;• Airflow / Airbyte clients · PDF/CSV reports&lt;br&gt;&lt;b&gt;owns&lt;/b&gt; PostgreSQL &lt;i&gt;portal_execution&lt;/i&gt;&lt;br&gt;&lt;i&gt;stateless · any replicas&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=13.2;fontColor=#374151;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c237"><mxGeometry x="8" y="40" width="346" height="262" as="geometry"/></mxCell><mxCell id="c242" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF694B;strokeWidth=1.5;shadow=0;" vertex="1" parent="c226"><mxGeometry x="682" y="48" width="304" height="306" as="geometry"/></mxCell><mxCell id="c243" value="" style="rounded=0;html=1;fillColor=#FF694B;strokeColor=none;" vertex="1" parent="c242"><mxGeometry x="0" y="6" width="4" height="294" as="geometry"/></mxCell><mxCell id="c244" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c242"><mxGeometry x="10" y="7" width="30" height="30" as="geometry"/></mxCell><mxCell id="c245" value="&lt;b&gt;worker(s)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=15;fontColor=#0B2C4D;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c242"><mxGeometry x="46" y="6" width="252" height="32" as="geometry"/></mxCell><mxCell id="c246" value="&lt;i&gt;image …-backend · python -m app.worker&lt;/i&gt;&lt;br&gt;• pops jobs from Redis, builds the plan&lt;br&gt;• runs dbt / edr / SQLFluff / profiler / Colibri&lt;br&gt;• streams every log line to a Redis stream&lt;br&gt;• acts on cancel messages&lt;br&gt;• writes run history + heartbeat (crash ⇒ interrupted)&lt;br&gt;• fires schedules&lt;br&gt;• invalidates insights caches&lt;br&gt;&lt;i&gt;scale: one per N concurrent jobs · WORKER_CONCURRENCY=4&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=13.2;fontColor=#374151;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c242"><mxGeometry x="8" y="40" width="290" height="262" as="geometry"/></mxCell><mxCell id="c247" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F9E8F;strokeWidth=1.5;shadow=0;" vertex="1" parent="c226"><mxGeometry x="994" y="48" width="330" height="306" as="geometry"/></mxCell><mxCell id="c248" value="" style="rounded=0;html=1;fillColor=#2F9E8F;strokeColor=none;" vertex="1" parent="c247"><mxGeometry x="0" y="6" width="4" height="294" as="geometry"/></mxCell><mxCell id="c249" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c247"><mxGeometry x="10" y="7" width="30" height="30" as="geometry"/></mxCell><mxCell id="c250" value="&lt;b&gt;insights&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=15;fontColor=#0B2C4D;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c247"><mxGeometry x="46" y="6" width="278" height="32" as="geometry"/></mxCell><mxCell id="c251" value="&lt;i&gt;image …-insights · read side&lt;/i&gt;&lt;br&gt;&lt;b&gt;/api/elementary · sqlfluff · profiler&lt;br&gt;assets · finops · insights · ask-ai&lt;/b&gt;&lt;br&gt;• reads dbt artifacts (target/, edr_target/) read-only&lt;br&gt;• Elementary results · SQLFluff · profiler&lt;br&gt;• FinOps cost &amp;amp; advisor&lt;br&gt;• Ask AI: tool-using LLM agent, ≤ 12 rounds,&lt;br&gt;&amp;nbsp;&amp;nbsp;SELECT-only SQL (sqlglot-checked), row cap, 90 s timeout&lt;br&gt;• recommendations for the home page&lt;br&gt;&lt;b&gt;owns&lt;/b&gt; nothing (caches only) · &lt;i&gt;any replicas&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=13.2;fontColor=#374151;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c247"><mxGeometry x="8" y="40" width="316" height="262" as="geometry"/></mxCell><mxCell id="c252" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=1.5;shadow=0;" vertex="1" parent="c226"><mxGeometry x="1332" y="48" width="290" height="306" as="geometry"/></mxCell><mxCell id="c253" value="" style="rounded=0;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="c252"><mxGeometry x="0" y="6" width="4" height="294" as="geometry"/></mxCell><mxCell id="c254" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c252"><mxGeometry x="10" y="7" width="30" height="30" as="geometry"/></mxCell><mxCell id="c255" value="&lt;b&gt;semantic&lt;/b&gt
s="geometry"/></mxCell><mxCell id="c349" value="Pydantic" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#334155;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;fontStyle=1;" vertex="1" parent="c318"><mxGeometry x="492" y="126" width="110" height="26" as="geometry"/></mxCell><mxCell id="c350" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c318"><mxGeometry x="614" y="126" width="26" height="26" as="geometry"/></mxCell><mxCell id="c351" value="JWT" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#334155;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;fontStyle=1;" vertex="1" parent="c318"><mxGeometry x="642" y="126" width="110" height="26" as="geometry"/></mxCell><mxCell id="c352" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c318"><mxGeometry x="764" y="126" width="26" height="26" as="geometry"/></mxCell><mxCell id="c353" value="/metrics" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#334155;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;fontStyle=1;" vertex="1" parent="c318"><mxGeometry x="792" y="126" width="110" height="26" as="geometry"/></mxCell><mxCell id="c354" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c318"><mxGeometry x="914" y="126" width="26" height="26" as="geometry"/></mxCell><mxCell id="c355" value="pytest + fakeredis" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#334155;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;fontStyle=1;" vertex="1" parent="c318"><mxGeometry x="942" y="126" width="110" height="26" as="geometry"/></mxCell><mxCell id="c356" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c318"><mxGeometry x="1064" y="126" width="26" height="26" as="geometry"/></mxCell><mxCell id="c357" value="ruff" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#334155;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;fontStyle=1;" vertex="1" parent="c318"><mxGeometry x="1092" y="126" width="110" height="26" as="geometry"/></mxCell><mxCell id="c358" value="&lt;b&gt;PORTAL_SERVICES&lt;/b&gt; picks the routers &amp;amp; tables a process hosts: &lt;b&gt;all&lt;/b&gt; = single-node (SQLite), or one service per container.&lt;br&gt;&lt;b&gt;app/clients/&lt;/b&gt;: in-process call if the peer is local, else its /internal HTTP API.&lt;br&gt;&lt;b&gt;Each service migrates its own tables on start&lt;/b&gt; (Alembic, advisory-locked).&lt;br&gt;&lt;b&gt;/api/health&lt;/b&gt; · JSON logs · &lt;b&gt;openapi.json&lt;/b&gt; checked in CI · &lt;b&gt;/api/version&lt;/b&gt;.&lt;br&gt;Non-root (10001) · Docker or Podman · PORTAL_USER=0:0 for Windows bind mounts." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#334155;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c318"><mxGeometry x="1220" y="44" width="700" height="124" as="geometry"/></mxCell><mxCell id="c359" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="1370" width="1940" height="360" as="geometry"/></mxCell><mxCell id="c360" value="" style="rounded=1;arcSize=0;html=1;fillColor=#334155;strokeColor=#334155;" vertex="1" parent="c359"><mxGeometry x="0" y="0" width="1940" height="40" as="geometry"/></mxCell><mxCell id="c361" value="" style="rounded=1;arcSize=18;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="c359"><mxGeometry x="6" y="5" width="30" height="30" as="geometry"/></mxCell><mxCell id="c362" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c359"><mxGeometry x="8" y="7" width="26" height="26" as="geometry"/></mxCell><mxCell id="c363" value="&lt;b&gt;State &amp;amp; data plane&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=16;fontColor=#ffffff;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c359"><mxGeometry x="44" y="4" width="300" height="32" as="geometry"/></mxCell><mxCell id="c364" value="nothing in Redis has to survive a restart" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=13.2;fontColor=#E6F0F7;align=right;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c359"><mxGeometry x="1420" y="4" width="510" height="32" as="geometry"/></mxCell><mxCell id="c365" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#336791;strokeWidth=1.5;shadow=0;" vertex="1" parent="c359"><mxGeometry x="14" y="52" width="450" height="296" as="geometry"/></mxCell><mxCell id="c366" value="" style="rounded=0;html=1;fillColor=#336791;strokeColor=none;" vertex="1" parent="c365"><mxGeometry x="0" y="6" width="4" height="284" as="geometry"/></mxCell><mxCell id="c367" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c365"><mxGeometry x="10" y="7" width="34" height="34" as="geometry"/></mxCell><mxCell id="c368" value="&lt;b&gt;PostgreSQL 17&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=15;fontColor=#0B2C4D;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c365"><mxGeometry x="50" y="6" width="394" height="36" as="geometry"/></mxCell><mxCell id="c369" value="&lt;b&gt;One database per service that owns tables&lt;/b&gt;&lt;br&gt;• &lt;b&gt;portal_identity&lt;/b&gt; — users, roles, policies,&lt;br&gt;&amp;nbsp;&amp;nbsp;sessions, lockouts, refresh tokens, audit logs, settings&lt;br&gt;• &lt;b&gt;portal_execution&lt;/b&gt; — run history, schedules,&lt;br&gt;&amp;nbsp;&amp;nbsp;alert settings, platform module settings&lt;br&gt;A service never reads another&#x27;s tables: it calls the owning service.&lt;br&gt;SQLite for the single-node portal only&lt;br&gt;Managed PostgreSQL supported (DATABASE_URL_*)" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.6;fontColor=#374151;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c365"><mxGeometry x="8" y="44" width="436" height="248" as="geometry"/></mxCell><mxCell id="c370" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC382D;strokeWidth=1.5;shadow=0;" vertex="1" parent="c359"><mxGeometry x="472" y="52" width="450" height="296" as="geometry"/></mxCell><mxCell id="c371" value="" style="rounded=0;html=1;fillColor=#DC382D;strokeColor=none;" vertex="1" parent="c370"><mxGeometry x="0" y="6" width="4" height="284" as="geometry"/></mxCell><mxCell id="c372" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c370"><mxGeometry x="10" y="7" width="34" height="34" as="geometry"/></mxCell><mxCell id="c373" value="&lt;b&gt;Redis 7&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=15;fontColor=#0B2C4D;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c370"><mxGeometry x="50" y="6" width="394" height="36" as="geometry"/></mxCell><mxCell id="c374" value="&lt;b&gt;Job queue&lt;/b&gt; — execution API → worker (LIST)&lt;br&gt;&lt;b&gt;Live logs&lt;/b&gt; — one STREAM per job; any API replica&lt;br&gt;&amp;nbsp;&amp;nbsp;serves the WebSocket&lt;br&gt;&lt;b&gt;Cancel&lt;/b&gt; — pub/sub channel the owning worker acts on&lt;br&gt;&lt;b&gt;Cache invalidation&lt;/b&gt; — worker → insights&lt;br&gt;&lt;b&gt;Email sign-in codes&lt;/b&gt; — redeemable on any identity replica&lt;br&gt;Password-protected, internal network only,&lt;br&gt;no persistence (appendonly off)" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.6;fontColor=#374151;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c370"><mxGeometry x="8" y="44" width="436" height="248" as="geometry"/></mxCell><mxCell id="c375" value="" style="rounded=1;arcSize=3;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;" vertex="1" parent="c359"><mxGeometry x="930" y="52" width="996" height="296" as="geometry"/></mxCell><mxCell id="c376" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c375"><mxGeometry x="690" y="8" width="34" height="34" as="geometry"/></mxCell><mxCell id="c377" value="&lt;b&gt;Volumes&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=14;fontColor=#0B2C4D;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c375"><mxGeometry x="730" y="8" width="250" height="34" as="geometry"/></mxCell><mxCell id="c378" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;shadow=0;" vertex="1" parent="c375"><mxGeometry x="12" y="52" width="440" height="236" as="geometry"/></mxCell><mxCell id="c379" value="" style="rounded=0;html=1;fillColor=#B45309;strokeColor=none;" vertex="1" parent="c378"><mxGeometry x="0" y="6" width="4" height="224" as="geometry"/></mxCell><mxCell id="c380" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c378"><mxGeometry x="10" y="7" width="26" height="26" as="geometry"/></mxCell><mxCell id="c381" value="&lt;b&gt;workspace  (the client&#x27;s dbt project)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.5;fontColor=#0B2C4D;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c378"><mxGeometry x="42" y="6" width="392" height="28" as="geometry"/></mxCell><mxCell id="c382" value="models · macros · tests · seeds · snapshots&lt;br&gt;profiles.yml + .env (warehouse login)&lt;br&gt;&lt;b&gt;target/&lt;/b&gt; manifest.json · catalog.json · run_results&lt;br&gt;&lt;b&gt;edr_target/&lt;/b&gt; Elementary report · logs/ · dbt_packages/&lt;br&gt;&lt;b&gt;git mode&lt;/b&gt;: DBT_PROJECT_GIT_URL, cloned by the API&lt;br&gt;execution API &amp;amp; worker: read-write&lt;br&gt;insights &amp;amp; semantic: &lt;b&gt;read-only&lt;/b&gt;&lt;br&gt;K8s: ReadWriteMany when pods span nodes" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#374151;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c378"><mxGeometry x="8" y="36" width="426" height="196" as="geometry"/></mxCell><mxCell id="c383" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;shadow=0;" vertex="1" parent="c375"><mxGeometry x="460" y="52" width="250" height="112" as="geometry"/></mxCell><mxCell id="c384" value="" style="rounded=0;html=1;fillColor=#B45309;strokeColor=none;" vertex="1" parent="c383"><mxGeometry x="0" y="6" width="4" height="100" as="geometry"/></mxCell><mxCell id="c385" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c383"><mxGeometry x="10" y="7" width="26" height="26" as="geometry"/></mxCell><mxCell id="c386" value="&lt;b&gt;semantic_data&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overfl
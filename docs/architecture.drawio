t;html=1;whiteSpace=wrap;overflow=hidden;fontSize=11.4;fontColor=#374151;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c534"><mxGeometry x="8" y="34" width="196" height="52" as="geometry"/></mxCell><mxCell id="c539" value="" style="rounded=1;arcSize=5;html=1;fillColor=#FFFFFF;strokeColor=#FF694B;strokeWidth=1.5;" vertex="1" parent="c494"><mxGeometry x="14" y="256" width="872" height="150" as="geometry"/></mxCell><mxCell id="c540" value="&lt;b&gt;Shared macros &amp;amp; tests&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=14.4;fontColor=#0B2C4D;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c494"><mxGeometry x="24" y="260" width="850" height="22" as="geometry"/></mxCell><mxCell id="c541" value="• &lt;b&gt;audit_columns&lt;/b&gt; — created / updated audit columns&lt;br&gt;• &lt;b&gt;generate_database_name · generate_schema_name&lt;/b&gt; — layered naming&lt;br&gt;• &lt;b&gt;grant_access&lt;/b&gt; · &lt;b&gt;grant_package_access&lt;/b&gt; — role grants per package schema&lt;br&gt;• &lt;b&gt;metadata_database&lt;/b&gt; — bootstrap METADATA_ANALYTICS&lt;br&gt;• &lt;b&gt;package_enabled&lt;/b&gt; — run hooks only if the package is installed" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#374151;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c494"><mxGeometry x="24" y="284" width="420" height="120" as="geometry"/></mxCell><mxCell id="c542" value="• &lt;b&gt;profile_model&lt;/b&gt; — profiling run-operation&lt;br&gt;• &lt;b&gt;test_multi_layer_reconciliation&lt;/b&gt; — generic test across layers&lt;br&gt;• SQLFluff config &amp;amp; models/sqlfluff · cube/ model templates&lt;br&gt;• &lt;b&gt;versions.yml&lt;/b&gt; — single source of version truth,&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;sync_versions.py&lt;/b&gt; regenerates packages.yml" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#374151;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c494"><mxGeometry x="460" y="284" width="420" height="120" as="geometry"/></mxCell><mxCell id="c543" value="&lt;b&gt;One package, no portal needed:&lt;/b&gt; &lt;i&gt;dbt run-operation bootstrap_metadata_database → dbt build → edr report&lt;/i&gt; works in plain CI. Elementary pip &amp;amp; dbt package versions stay aligned (min/max pins). Docs: OPERATIONS · PACKAGES · REFERENCE · technical per package." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=12.0;fontColor=#475569;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c494"><mxGeometry x="14" y="414" width="870" height="90" as="geometry"/></mxCell><mxCell id="c544" value="" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontSize=13.2;fontColor=#1F2937;align=left;verticalAlign=top;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="c494"><mxGeometry x="14" y="482" width="870" height="22" as="geometry"/></mxCell><mxCell id="c545" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF1F4;strokeColor=#E11D48;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="936" y="1940" width="560" height="560" as="geometry"/></mxCell><mxCell id="c546" value="" style="rounded=1;arcSize=0;html=1;fillColor=#E11D48;strokeColor=#E11D48;" vertex="1" parent="c545"><mxGeometry x="0" y="0" width="560" height="40" as="geometry"/></mxCell><mxCell id="c547" value="" style="rounded=1;arcSize=18;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="c545"><mxGeometry x="6" y="5" width="30" height="30" as="geometry"/></mxCell><mxCell id="c548" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;verticalLabelPosition=bottom;" vertex="1" parent="c545"><mxGeometry x="8"
# Consumed by compose.yaml (and compose.single.yaml). Copy to .env (git-ignored),
# or let deploy/client/setup.sh write it for you: it fills in the secrets below.
#
# Required: where the client's dbt project is, and four generated secrets.
# Warehouse credentials are NOT configured here (see further down for why).
# Full reference: docs/ONBOARDING.md.

# ── Where's the project? (pick ONE) ─────────────────────────────────────────
# A) Mount mode: host path of the client dbt project, mounted at /workspace.
#    Use a path relative to compose.yaml: Podman's Windows client mangles
#    absolute /mnt/c/... paths into /mnt/c/mnt/c/...
DBT_PROJECT_PATH=../capgemini_dbt_core

# B) Git mode: comment out DBT_PROJECT_PATH above and set these instead.
#    The backend clones the repo on first start and updates it on each restart.
# DBT_PROJECT_GIT_URL=https://github.com/<org>/<repo>.git
# DBT_PROJECT_GIT_REF=main
# DBT_PROJECT_GIT_TOKEN=            # read-only PAT / deploy token (HTTPS repos)
# DBT_PROJECT_GIT_USERNAME=         # default x-access-token (GitHub); GitLab: oauth2

# Either mode: the dbt project is in a sub-folder of the repo / mount.
# DBT_PROJECT_SUBDIR=transform/dbt

# ── Secrets (generate each: openssl rand -base64 36) ───────────────────────
# Session tokens are signed with JWT_SECRET; changing it signs everyone out.
JWT_SECRET=
# Shared by the backend and the cube container.
CUBE_API_SECRET=
# The bundled PostgreSQL (users, audit, run history) and Redis (job queue, live logs).
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Versions (releases.yml lists the combinations released together) ──────
# IMAGE_REGISTRY=ghcr.io/omaryehia015
BACKEND_TAG=1.0.1
FRONTEND_TAG=1.0.0
CUBE_TAG=1.0.1

# ── Scale ───────────────────────────────────────────────────────────────────
# dbt jobs one worker runs at once; more workers: docker compose up -d --scale worker=3
# (workers share the dbt project folder, so they must run on the same host or
# a ReadWriteMany volume).
# WORKER_CONCURRENCY=4

# ── Everything else is optional ─────────────────────────────────────────────
# Warehouse credentials: set them in the portal (Setup Assistant, Warehouse
# step), for Snowflake, Databricks or any dbt adapter. Or the environment
# (Snowflake DBT_PKG_*/SNOWFLAKE_*, Databricks DATABRICKS_HOST/HTTP_PATH/TOKEN
# with DBT_WH_TYPE=databricks): don't set those here either. The
# backend's entrypoint loads them straight out of the project's OWN .env
# (next to its profiles.yml) on every start. That project already needs those
# variables to run `dbt` by itself; the portal just reads the same file.
# Only set one here to override what the project's .env says for THIS
# deployment specifically (e.g. a staging warehouse for this instance only).
# DBT_PKG_ACCOUNT=

# production (default) | development. production generates a random
# password per seeded account, printed once to `docker compose logs backend`.
# development seeds the documented demo passwords (admin123! etc) -- for a
# local demo only; see docs/ONBOARDING.md section 5.
# ENVIRONMENT=development

# Logs: json (default, one object per line) | text. LOG_LEVEL=INFO.
# LOG_FORMAT=text
# Prometheus metrics at http://backend:8000/metrics (internal only).
# METRICS_ENABLED=true

# Failure alerts (defaults; admins can change them on Governance -> Failure alerts).
# NOTIFY_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# NOTIFY_TEAMS_WEBHOOK=https://....webhook.office.com/...
# NOTIFY_EMAIL_TO=data-team@client.com     # needs SMTP_HOST
# PORTAL_BASE_URL=https://portal.client.com  # links alerts to the run

# Optional modules: bundled | external | off. Unset: external when the
# module's URL is set, otherwise off (its pages disappear). The Modules page
# in the portal can change these and the connection details below.
# AIRBYTE_MODE=off
# AIRFLOW_MODE=external

# Airflow REST API (DAG list, trigger, pause) -- service account, basic auth.
# AIRFLOW_URL=http://airflow-webserver:8080
# AIRFLOW_USERNAME=
# AIRFLOW_PASSWORD=
# Embed the Airflow UI same-origin: the frontend serves this host:port webserver
# under /airflow-ui/ (Airflow needs AIRFLOW__WEBSERVER__BASE_URL=http://<portal>/airflow-ui).
# AIRFLOW_UPSTREAM=host.containers.internal:8080
# DAG Studio: Airflow's dags/ folder mounted into the backend. Unset, the studio
# asks for a Git repository or a shared folder. See docs/ONBOARDING.md, section 5b.
# AIRFLOW_DAGS_DIR=/airflow/dags

# Airbyte (data ingestion) -- installed next to the portal with `abctl`, not
# part of this compose file. See docs/ONBOARDING.md, section 5a.
# AIRBYTE_URL=http://host.docker.internal:8000   # Podman: host.containers.internal
# AIRBYTE_CLIENT_ID=                            # `abctl local credentials`
# AIRBYTE_CLIENT_SECRET=
# AIRBYTE_WORKSPACE_ID=                         # default: every workspace
# AIRBYTE_UI_URL=http://<server-hostname>:8000  # link the browser opens

# dbt runtime
# DBT_TARGET=dev                    # overrides profiles.yml's own `target:`
# DBT_PROFILES_DIR=/workspace/profiles
# DBT_DEPS_ON_START=false           # run `dbt deps` on every start
# EXTRA_PIP_PACKAGES=dbt-bigquery~=1.8.0   # non-Snowflake warehouse (build arg)

# AI (home page copilot and the Ask AI page). Off until a key is set. Set ONE
# provider's key; with AI_PROVIDER=auto the first one found is used, in this order:
# ANTHROPIC_API_KEY=                # Claude          (default model claude-opus-5)
# OPENAI_API_KEY=                   # GPT / Codex     (default model gpt-5)
# GEMINI_API_KEY=                   # Google Gemini   (default model gemini-2.5-pro)
# Pin a provider and/or model instead of auto-detecting:
# AI_PROVIDER=auto                  # auto | anthropic | openai | gemini | openai_compatible
# AI_MODEL=                         # e.g. gpt-5-codex, gemini-2.5-flash, claude-sonnet-5
# Any other OpenAI-compatible endpoint (Azure OpenAI, Mistral, Groq, DeepSeek,
# Ollama, vLLM, LiteLLM...): AI_PROVIDER=openai_compatible plus these. AI_MODEL is required.
# AI_BASE_URL=http://ollama:11434/v1
# AI_API_KEY=                       # overrides the provider's own key variable
# AI_EFFORT=medium                  # reasoning effort where the model supports it
# Ask AI > Data Marts & KPIs runs read-only SELECTs on the project's own dbt
# models and sends the results to the AI service. Set false where client data
# must not leave the network (the Project, Lineage & Bugs tab keeps working).
# AI_DATA_ENABLED=true

# Semantic layer (Semantic Modeling page). Nothing else to set: the stack runs
# Cube as its `cube` service, configured from the page (warehouse login from
# the dbt profile or typed in, model generated from the dbt manifest).

# Sign-in. Username (or email) + portal password always works; these add to it.
# LDAP / Active Directory: first successful sign-in creates the portal account
# with LDAP_DEFAULT_ROLE (change it later in Governance > Users).
# LDAP_URL=ldaps://dc.corp.local:636
# LDAP_USER_DN={username}@corp.local     # OpenLDAP: uid={username},ou=people,dc=corp,dc=com
# LDAP_BASE_DN=dc=corp,dc=local          # optional: read name + email from the directory
# LDAP_START_TLS=false                   # true for ldap:// servers that support StartTLS
# LDAP_DEFAULT_ROLE=Data Analyst
# Email sign-in code (passwordless, local accounts): needs SMTP. In development
# without SMTP the code is printed to `docker compose logs backend`.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=portal@company.com
# SMTP_PASSWORD=
# SMTP_FROM=portal@company.com
# EMAIL_LOGIN_ENABLED=true

# Misc
# PORTAL_PORT=8080
# An external PostgreSQL instead of the bundled one: set DATABASE_URL for
# backend and worker in compose.override.yaml (one database, e.g. portal).
# AIRFLOW_URL=http://airflow-webserver:8080
# JWT_EXPIRES_MINUTES=480
# PREFLIGHT_STRICT=false            # refuse to start if preflight finds a problem
# Behind a TLS-inspecting proxy (Zscaler...): put its root CA (PEM) in the dbt
# project's .certs/ folder, or point this at a PEM file/folder inside the container.
# PORTAL_CA_CERTS=/workspace/.certs
